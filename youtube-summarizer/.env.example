# At least one API key is required (configure the providers you want to use)

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key-here

# Google Gemini
GOOGLE_API_KEY=your-google-api-key-here

# Ollama (local, no API key needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Whisper model size for audio fallback (tiny, base, small, medium, large)
WHISPER_MODEL=base
